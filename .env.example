# App
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-long-random-string

# Single operator login
AUTH_EMAIL=you@example.com
# Prefer AUTH_PASSWORD_HASH (bcrypt). AUTH_PASSWORD works for local/dev only.
AUTH_PASSWORD=change-me
# AUTH_PASSWORD_HASH=

# Encrypt API keys at rest (min 16 chars)
ENCRYPTION_KEY=replace-with-another-long-secret

# Supabase Postgres — for this app's long-lived Node server, prefer DIRECT_URL.
# DATABASE_URL can be the pooled URL; the app uses DIRECT_URL when set.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Supabase Storage (public bucket for Buffer-fetchable video URLs)
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_VIDEOS_BUCKET=videos
